package {
    default_team: "trendy_team_interactive_tv",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "TvProviderTests",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
    ],
    static_libs: [
        "junit",
        "androidx.test.rules",
    ],
    instrumentation_for: "TvProvider",
}

android_test {
    name: "TvExtensionProviderTest",
    srcs: ["src/com/android/providers/tv/TvExtensionProviderTest.java"],
    platform_apis: true,
    static_libs: [
        "junit",
        "androidx.test.rules",
        "tv_extension_provider_lib",
    ],
    manifest: "AndroidManifestTvExtensionProviderTest.xml",
    data: [
        ":TvProvider",
    ],

    test_suites: ["TvExtensionProviderTest"],
}
